# Server
PORT=8080
ENV=development

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=rendez
DB_PASSWORD=rendez_secret
DB_NAME=rendez_db
DB_SSLMODE=disable

# JWT Config (TBD-03: access 30m, refresh 14d)
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=336h

# External Services
OCR_SERVICE_URL=http://localhost:8000
MAP_SERVICE_URL=http://localhost:8001
MAP_SERVICE_API_KEY=dummy-map-api-key

# Storage & Upload
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./uploads
